// ADR-0002: PostgreSQL through Prisma. Money columns are BIGINT minor units (ADR-0006), times are
// timestamptz. The `reservations` table arrived with S-03; the ledger's `reservation_id` is a
// foreign key to it since then.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Program {
  programId      String    @id @map("program_id") @db.VarChar(64)
  currency       String    @db.Char(3)
  creditLimit    BigInt    @map("credit_limit")
  reserved       BigInt
  limitEventTime DateTime? @map("limit_event_time") @db.Timestamptz(6)
  asOf           DateTime? @map("as_of") @db.Timestamptz(6)
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  movements    CapacityMovement[]
  reservations Reservation[]

  @@map("programs")
}

/// Who created the reservation: the client over HTTP, or a reconciliation snapshot (S-06).
enum ReservationSource {
  client
  reconciliation

  @@map("reservation_source")
}

/// The claim one invoice holds on a program's capacity (glossary). The pair (program, invoice)
/// is the public identity (A-07); `id` exists so the ledger can point at one row. `status` is
/// derived from `held` and never stored. `rate` arrives with S-04.
model Reservation {
  id              String            @id @default(uuid()) @db.Uuid
  programId       String            @map("program_id") @db.VarChar(64)
  invoiceId       String            @map("invoice_id") @db.VarChar(128)
  invoiceAmount   BigInt            @map("invoice_amount")
  invoiceCurrency String            @map("invoice_currency") @db.Char(3)
  /// The program currency `reserved_amount` and `held` are in; fixed for life (ADR-0007).
  currency        String            @db.Char(3)
  reservedAmount  BigInt            @map("reserved_amount")
  held            BigInt
  /// A-02: the rate invoice_amount was converted at, exact and fixed for life (ADR-0006).
  rate            Decimal           @db.Decimal(20, 8)
  /// ADR-0009: how much of the invoice has been released, in invoice currency. `held` is
  /// derived from what is left, so the last instalment closes at exactly zero.
  releasedInvoiceAmount BigInt      @map("released_invoice_amount")
  source          ReservationSource
  clientId        String?           @map("client_id") @db.VarChar(128)
  createdAt       DateTime          @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime          @updatedAt @map("updated_at") @db.Timestamptz(6)

  program   Program            @relation(fields: [programId], references: [programId])
  movements CapacityMovement[]

  @@unique([programId, invoiceId])
  @@map("reservations")
}

/// Exactly four kinds (glossary): the ledger has no fifth.
enum CapacityMovementKind {
  limit_set
  reserve
  release
  adjustment

  @@map("capacity_movement_kind")
}

/// The ledger (A-15): append-only, each row carries the balances it left behind.
model CapacityMovement {
  id             BigInt               @id @default(autoincrement())
  programId      String               @map("program_id") @db.VarChar(64)
  reservationId  String?              @map("reservation_id") @db.Uuid
  kind           CapacityMovementKind
  /// The currency of the four amounts on this row: the program's at the time (ADR-0007).
  currency       String               @db.Char(3)
  deltaHeld      BigInt               @map("delta_held")
  limitAfter     BigInt               @map("limit_after")
  reservedAfter  BigInt               @map("reserved_after")
  availableAfter BigInt               @map("available_after")
  clientId       String?              @map("client_id") @db.VarChar(128)
  messageId      String?              @map("message_id") @db.VarChar(128)
  releaseId      String?              @map("release_id") @db.VarChar(128)
  reason         String?              @db.VarChar(16)
  occurredAt     DateTime             @map("occurred_at") @db.Timestamptz(6)

  program     Program      @relation(fields: [programId], references: [programId])
  reservation Reservation? @relation(fields: [reservationId], references: [id], onDelete: Restrict)

  @@index([programId, id])
  @@index([reservationId])
  @@map("capacity_movements")
}

/// The fourth outcome of the glossary, duplicate, is `duplicate_count` on the first record.
enum TreasuryMessageOutcome {
  applied
  stale
  rejected

  @@map("treasury_message_outcome")
}

/// Every consumed treasury message and what became of it (A-13). A redelivery bumps
/// `duplicate_count` on the first record instead of adding a row.
model TreasuryMessage {
  messageId      String                 @id @map("message_id") @db.VarChar(128)
  programId      String?                @map("program_id") @db.VarChar(64)
  type           String?                @db.VarChar(32)
  payload        Json                   @db.JsonB
  outcome        TreasuryMessageOutcome
  duplicateCount Int                    @default(0) @map("duplicate_count")
  error          String?
  receivedAt     DateTime               @map("received_at") @db.Timestamptz(6)
  processedAt    DateTime               @default(now()) @map("processed_at") @db.Timestamptz(6)

  @@map("treasury_messages")
}
